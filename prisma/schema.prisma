generator client {
  provider   = "prisma-client"
  output     = "../app/generated/prisma"
  // JS driver only — CloudLinux blocks Prisma's native .so engine (open EEXIST)
  engineType = "client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Page {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?  @db.Text
  content     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Rate {
  id        String   @id @default(cuid())
  metal     String
  product   String
  unit      String   @default("RM / Gram")
  buyPrice  Decimal  @db.Decimal(12, 2)
  sellPrice Decimal  @db.Decimal(12, 2)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

/// Latest GoldAPI snapshot per metal (public pages read this, never the API).
model MetalQuote {
  id            String   @id @default(cuid())
  metal         String
  currency      String
  symbol        String
  price         Decimal  @db.Decimal(16, 6)
  bid           Decimal? @db.Decimal(16, 6)
  ask           Decimal? @db.Decimal(16, 6)
  unit          String   @default("troy_ounce")
  priceGram     Decimal? @db.Decimal(16, 6)
  priceKg       Decimal? @db.Decimal(16, 6)
  priceTael     Decimal? @db.Decimal(16, 6)
  melt24k       Decimal? @db.Decimal(16, 6)
  melt22k       Decimal? @db.Decimal(16, 6)
  melt21k       Decimal? @db.Decimal(16, 6)
  melt18k       Decimal? @db.Decimal(16, 6)
  change        Decimal? @db.Decimal(12, 6)
  changePercent Decimal? @db.Decimal(8, 4)
  raw           Json
  fetchedAt     DateTime
  source        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([metal, currency])
}

/// Admin-configured daily refresh times, e.g. "06:30" in RATE_TIMEZONE.
model RateRefreshTime {
  id        String   @id @default(cuid())
  time      String   @unique
  createdAt DateTime @default(now())
}

/// Prevents the same scheduled slot from fetching twice in one day.
model RateFetchLog {
  slotKey   String   @id
  fetchedAt DateTime
  source    String
  ok        Boolean  @default(true)
  error     String?  @db.Text
}

/// Price book assigned to members. Offsets apply on top of GoldAPI market rates.
model RateBook {
  id          String         @id @default(cuid())
  name        String
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  adjustments RateBookAdj[]
  members     Member[]
}

model RateBookAdj {
  id        String   @id @default(cuid())
  bookId    String
  metal     String
  unitKey   String
  buyDelta  Decimal  @default(0) @db.Decimal(16, 6)
  sellDelta Decimal  @default(0) @db.Decimal(16, 6)
  book      RateBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, metal, unitKey])
}

/// Portal member. id 1 => memberId SHB0000001. They cannot change memberId.
model Member {
  id           Int         @id @default(autoincrement())
  memberId     String      @unique
  username     String      @unique
  passwordHash String
  phone        String
  email        String      @unique
  fullName     String
  isActive     Boolean     @default(true)
  xauGrams        Decimal  @default(0) @db.Decimal(16, 6)
  fundMyr         Decimal  @default(0) @db.Decimal(16, 2)
  tradingLimitMyr Decimal  @default(0) @db.Decimal(16, 2)
  address         String   @default("")
  companyName     String   @default("")
  registrationNo  String   @default("")
  locale          String   @default("en")
  rateBookId   String?
  rateBook     RateBook?   @relation(fields: [rateBookId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  cartItems    CartItem[]
  orders       Order[]
  adjustments  MemberAdj[]
  deposits      Deposit[]
  bankAccounts  BankAccount[]
  withdrawals   Withdrawal[]
  transfersOut  GoldTransfer[] @relation("TransferFrom")
  transfersIn   GoldTransfer[] @relation("TransferTo")
  announcementReads AnnouncementRead[]
}

model BankAccount {
  id         String    @id @default(cuid())
  memberId   Int
  holderName String
  bankName   String
  accountNo  String
  status     String    @default("pending")
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, status])
}

model Withdrawal {
  id            String    @id @default(cuid())
  memberId      Int
  kind          String
  amount        Decimal   @db.Decimal(16, 6)
  status        String    @default("pending")
  bankAccountId String?
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  member        Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([memberId])
}

model GoldTransfer {
  id           String    @id @default(cuid())
  fromMemberId Int
  toMemberId   Int
  grams        Decimal   @db.Decimal(16, 6)
  status       String    @default("pending")
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  fromMember   Member    @relation("TransferFrom", fields: [fromMemberId], references: [id], onDelete: Cascade)
  toMember     Member    @relation("TransferTo", fields: [toMemberId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([fromMemberId])
  @@index([toMemberId])
}

model Announcement {
  id        String             @id @default(cuid())
  title     String
  body      String             @db.Text
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  reads     AnnouncementRead[]
}

model AnnouncementRead {
  memberId       Int
  announcementId String
  readAt         DateTime     @default(now())
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@id([memberId, announcementId])
  @@index([announcementId])
}

/// Optional per-member overrides. Null buy/sell means inherit book (or market).
model MemberAdj {
  id        String  @id @default(cuid())
  memberId  Int
  metal     String
  unitKey   String
  buyDelta  Decimal? @db.Decimal(16, 6)
  sellDelta Decimal? @db.Decimal(16, 6)
  member    Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, metal, unitKey])
}

/// Member cart line for MYR/KG trade (locks board price at add time).
/// side=buy locks company sell price; side=sell locks company buy price.
model CartItem {
  id          String   @id @default(cuid())
  memberId    Int
  metal       String
  unitKey     String   @default("myr-kg")
  /// buy = member buys from us; sell = member sells to us
  side        String   @default("buy")
  lockedPrice Decimal  @db.Decimal(16, 6)
  qtyKg       Decimal  @db.Decimal(16, 6)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, metal, unitKey, side])
}

model Order {
  id          String      @id @default(cuid())
  orderNo     String      @unique
  memberId    Int
  status      String      @default("pending")
  totalAmount Decimal     @db.Decimal(16, 2)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  member      Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  items       OrderItem[]
}

model Deposit {
  id              String    @id @default(cuid())
  memberId        Int
  kind            String
  status          String    @default("pending")
  comment         String?   @db.Text
  proofPath       String?
  bankAccountId   String?
  creditedAmount  Decimal?  @db.Decimal(16, 6)
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  member          Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([memberId])
}

model PriceBar {
  pair       String   @db.VarChar(16)
  minute     DateTime
  buyOpen    Decimal  @db.Decimal(16, 6)
  buyHigh    Decimal  @db.Decimal(16, 6)
  buyLow     Decimal  @db.Decimal(16, 6)
  buyClose   Decimal  @db.Decimal(16, 6)
  sellOpen   Decimal  @db.Decimal(16, 6)
  sellHigh   Decimal  @db.Decimal(16, 6)
  sellLow    Decimal  @db.Decimal(16, 6)
  sellClose  Decimal  @db.Decimal(16, 6)
  marketOpen Boolean  @default(true)
  updatedAt  DateTime @updatedAt

  @@id([pair, minute])
}

model PriceSample {
  id         String   @id
  pair       String   @db.VarChar(16)
  buy        Decimal  @db.Decimal(16, 6)
  sell       Decimal  @db.Decimal(16, 6)
  marketOpen Boolean  @default(true)
  recordedAt DateTime
  createdAt  DateTime @default(now())

  @@index([pair, recordedAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  metal       String
  unitKey     String  @default("myr-kg")
  side        String  @default("buy")
  lockedPrice Decimal @db.Decimal(16, 6)
  qtyKg       Decimal @db.Decimal(16, 6)
  lineTotal   Decimal @db.Decimal(16, 2)
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}
