# MySQL connection string (local install, no password)
# Format: mysql://USER@HOST:PORT/DATABASE
#
# Create the database first, e.g.:
#   mysql -u root -e "CREATE DATABASE gold_invest;"
DATABASE_URL="mysql://root@localhost:3306/gold_invest"
SESSION_SECRET="replace-with-openssl-rand-base64-32"
ADMIN_EMAIL="admin@goldinvest.local"
ADMIN_PASSWORD="Admin123!"
GOLDAPI_TOKEN=""
GOLDAPI_BASE_URL="https://www.goldapi.io/api"
RATE_TIMEZONE="Asia/Kuala_Lumpur"

# Eliz market snapshots (server-only — browser calls /api/rates/market, never Eliz directly)
ELIZ_XAU_URL="https://api.eliz.gold/v0/web/public/xau/market_snapshot"
ELIZ_XAG_URL="https://api.eliz.gold/v0/web/public/xag/market_snapshot"

# Google reCAPTCHA v3 — https://www.google.com/recaptcha/admin
# Create a v3 key for your domain (include localhost for local testing).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
# Optional. Default 0.5. Lower = more traffic through, higher = stricter.
# RECAPTCHA_MIN_SCORE="0.5"

# Telegram notifications for new contact enquiries
# 1. Talk to @BotFather, /newbot, copy the bot token
# 2. Message the bot (or add it to a group)
# 3. Get chat id: open https://api.telegram.org/bot<TOKEN>/getUpdates
#    Use "chat":{"id": ...}  (negative for groups)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# WhatsApp Business Cloud API — order notifications
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# E.164 digits only, e.g. 60123456789
WHATSAPP_ADMIN_PHONE=""
# Approved template names in Meta Business Manager
WHATSAPP_TEMPLATE_ADMIN=""
WHATSAPP_TEMPLATE_CUSTOMER=""
WHATSAPP_TEMPLATE_LANG="en"

# WhatsApp webhooks — https://<your-domain>/api/whatsapp/webhook
# 1. Pick any secret string for Verify token (same value in Meta App Dashboard)
# 2. App Secret from Meta App Dashboard → App settings → Basic
# 3. Subscribe to the "messages" webhook field under WhatsApp → Configuration
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
